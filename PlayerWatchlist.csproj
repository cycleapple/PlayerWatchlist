<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/14.0.1">
    <PropertyGroup>
        <Authors>CY</Authors>
        <Version>1.0.0.1</Version>
        <TargetFramework>net10.0-windows</TargetFramework>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <DalamudLibPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)/</DalamudLibPath>
    </PropertyGroup>
    <Target Name="RequireApi14References" BeforeTargets="ResolveAssemblyReferences">
        <Error Condition="'$(DALAMUD_HOME)' == ''"
               Text="Set DALAMUD_HOME to an isolated Dalamud API14 reference directory. API13 references are not supported." />
        <Error Condition="!Exists('$(DalamudLibPath)Dalamud.dll')"
               Text="DALAMUD_HOME must contain Dalamud.dll from API14." />
        <GetAssemblyIdentity AssemblyFiles="$(DalamudLibPath)Dalamud.dll">
            <Output TaskParameter="Assemblies" ItemName="DalamudReferenceIdentity" />
        </GetAssemblyIdentity>
        <Error Condition="!$([System.String]::Copy('%(DalamudReferenceIdentity.Version)').StartsWith('14.'))"
               Text="Expected Dalamud API14; found %(DalamudReferenceIdentity.Version)." />
    </Target>
</Project>
